<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Produtos em Tempo Real</title>
    <script src="/socket.io/socket.io.js"></script>
    <style>
      body { font-family: Arial, sans-serif; } h1 { text-align: center; } form {
      margin: 10px auto; padding: 10px; max-width: 400px; border: 1px solid
      #ccc; border-radius: 5px; } ul { list-style: none; padding: 0; } li {
      margin-bottom: 10px; }
    </style>
  </head>
  <body>
    <h1>Produtos em Tempo Real</h1>

    <h2>Lista de Produtos</h2>
    <ul id="product-list">
      {{#each products}}
        <li>
          <strong>Nome:</strong>
          {{this.name}}
          <br />
          <strong>Preço:</strong>
          ${{this.price}}
          <br />
          <strong>Descrição:</strong>
          {{this.description}}
        </li>
      {{/each}}
    </ul>

    <h2>Adicionar Produto</h2>
    <form action="/add" method="POST">
      <label for="name">Nome:</label><br />
      <input type="text" id="name" name="name" required /><br />
      <label for="price">Preço:</label><br />
      <input type="number" id="price" name="price" required /><br />
      <label for="description">Descrição:</label><br />
      <textarea id="description" name="description" required></textarea><br />
      <button type="submit">Adicionar Produto</button>
    </form>

    <h2>Excluir Produto</h2>
    <form action="/delete" method="POST">
      <label for="id">ID do Produto:</label><br />
      <input type="number" id="id" name="id" required /><br />
      <button type="submit">Excluir Produto</button>
    </form>

    <script>
      const socket = io(); socket.on("updateProducts", (products) => { const
      productList = document.getElementById("product-list");
      productList.innerHTML = ""; products.forEach((product) => { const listItem
      = document.createElement("li"); listItem.innerHTML = `
      <strong>Nome:</strong> ${product.name} <br> <strong>Preço:</strong>
      $${product.price} <br> <strong>Descrição:</strong> ${product.description}
      `; productList.appendChild(listItem); }); });
    </script>
  </body>
</html>