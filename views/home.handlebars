<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lista de Produtos</title>
  </head>
  <body>
    <h1>Produtos Disponíveis</h1>
    <ul>
      {{#each products}}
        <li>
          <strong>Nome:</strong>
          {{this.name}}
          <br />
          <strong>Preço:</strong>
          ${{this.price}}
          <br />
          <strong>Descrição:</strong>
          {{this.description}}
        </li>
      {{/each}}
    </ul>
  </body>
</html>