<h1>Administração de Usuários</h1>
<table border="1">
  <tr>
    <th>Nome</th>
    <th>Email</th>
    <th>Função</th>
    <th>Ações</th>
  </tr>
  {{#each users}}
  <tr>
    <td>{{this.name}}</td>
    <td>{{this.email}}</td>
    <td>
      <form method="POST" action="/api/users/{{this._id}}/role" style="display:inline;">
        <select name="role">
          <option value="user" {{#if (eq this.role "user" )}}selected{{/if}}>User</option>
          <option value="admin" {{#if (eq this.role "admin" )}}selected{{/if}}>Admin</option>
        </select>
        <button type="submit">Alterar</button>
      </form>
    </td>
    <td>
      <form method="POST" action="/api/users/{{this._id}}/delete" style="display:inline;">
        <button type="submit" onclick="return confirm('Tem certeza?')">Excluir</button>
      </form>
    </td>
  </tr>
  {{/each}}
</table>